# ─────────────────────────────────────────────────────────────
# Scrye — example environment configuration
# ─────────────────────────────────────────────────────────────
# Generated from the Pydantic `Settings` model
# (backend/app/core/config.py) via `python -m scripts.gen_env_example`.
# Do NOT edit by hand — update the Settings model and regenerate.
#
# These are NON-SENSITIVE configuration variables only. The application
# master key is never set here; it is read from the Docker secret file
# referenced by SCRYE_APP_SECRET_KEY_FILE. Copy this file to `.env` for
# local development and adjust values as needed.
# ─────────────────────────────────────────────────────────────

# Human-readable application name shown in the UI and logs.
SCRYE_APP_NAME=Scrye

# Deployment environment: 'development' or 'production'.
SCRYE_ENVIRONMENT=production

# Root log level (DEBUG, INFO, WARNING, ERROR, CRITICAL).
SCRYE_LOG_LEVEL=INFO

# Bind address for the API server inside the container.
SCRYE_HOST=0.0.0.0

# Port the API server listens on inside the container.
SCRYE_PORT=8089

# Comma-separated list of allowed CORS origins for the dev frontend (e.g. http://localhost:5173). Empty in production (same-origin SPA).
SCRYE_CORS_ORIGINS=

# Filesystem path to the SQLite database file.
SCRYE_DATABASE_PATH=/data/scrye.db

# Path to the Docker secret file holding the application master key. The key content is NEVER set via an environment variable.
SCRYE_APP_SECRET_KEY_FILE=/run/secrets/app_secret_key

# Login session lifetime in hours (default 168 = 7 days).
SCRYE_SESSION_LIFETIME_HOURS=168

# Set the Secure flag on session cookies. Keep true in production (behind TLS-terminating Caddy); set false only for plain-HTTP local dev.
SCRYE_SESSION_COOKIE_SECURE=true

# Max authentication attempts allowed per client IP per window.
SCRYE_AUTH_RATE_LIMIT_ATTEMPTS=5

# Length of the auth rate-limit window in seconds.
SCRYE_AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Optional Trivy server URL for a shared vuln-DB cache.
SCRYE_TRIVY_SERVER_URL=

# Optional read-only docker-socket-proxy URL ('scan running images').
SCRYE_DOCKER_PROXY_URL=

# Path or name of the Trivy binary (resolved on PATH if a bare name).
SCRYE_TRIVY_BINARY=trivy

# Path or name of the Grype binary (resolved on PATH if a bare name).
SCRYE_GRYPE_BINARY=grype

# Path or name of the Syft binary (resolved on PATH if a bare name).
SCRYE_SYFT_BINARY=syft

# Maximum number of scans the in-process worker runs concurrently.
SCRYE_MAX_CONCURRENT_SCANS=2

# Per-scan wall-clock timeout in seconds (default 1800 = 30 minutes).
SCRYE_SCAN_TIMEOUT_SECONDS=1800

# Directory holding raw scanner artifacts (JSON output, SBOMs).
SCRYE_ARTIFACTS_DIR=/data/artifacts

# Directory holding backup bundles (manual and scheduled).
SCRYE_BACKUPS_DIR=/data/backups

# Comma-separated absolute paths under which filesystem (Grype 'dir:') scans are allowed. Empty disables filesystem scanning so arbitrary host paths (e.g. the database or secret files) can never be read.
SCRYE_FILESYSTEM_SCAN_ROOTS=

# Directory containing the built React SPA served by FastAPI.
SCRYE_FRONTEND_DIST_DIR=/app/frontend/dist
