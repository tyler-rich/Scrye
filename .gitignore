# ─────────────────────────────────────────────────────────────
# Scrye — .gitignore
# ─────────────────────────────────────────────────────────────

# === Secrets & sensitive runtime data (NEVER commit) ===
secrets/
*.secret
*.key
*.pem
*.p12
*.pfx
app_secret_key
**/app_secret_key
.env
.env.*
!.env.example
docker/secrets/
config.json            # transient docker registry auth files
*.vex.local

# === Application data / runtime ===
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
cache/
backups/
*.bundle
uploads/
artifacts/

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
env/
ENV/
.python-version

# Test / coverage / type-check caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.dmypy.json
coverage.xml
*.cover

# Alembic (keep migrations; ignore local scratch)
backend/alembic/versions/__pycache__/

# === Node / Frontend ===
node_modules/
.npm/
.pnpm-store/
.yarn/
frontend/dist/
frontend/build/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# === Docker ===
# (Compose & Dockerfile are tracked; local overrides are not)
docker-compose.override.yml
*.local.yml

# === Logs ===
logs/
*.log

# === Scanner working dirs / DBs (downloaded at runtime) ===
.trivy/
.cache/trivy/
.cache/grype/
.grype/
.syft/

# === IDE / Editor ===
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.fleet/

# === OS ===
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
