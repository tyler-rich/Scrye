# Keep the build context small and free of secrets / local cruft.

# Secrets & runtime data (NEVER send to the build context)
secrets/
docker/secrets/
**/app_secret_key
*.key
*.pem
.env
.env.*
!.env.example

# Application data / runtime
data/
cache/
backups/
uploads/
artifacts/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Python
**/__pycache__/
*.py[cod]
**/.venv/
**/venv/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
.coverage
htmlcov/
*.egg-info/

# Backend dev-only trees — never part of the runtime image (SC-14). The final
# stage's `COPY backend/ /app/backend/` only needs alembic/, alembic.ini, app/,
# and pyproject.toml at runtime; the test suite and the env-example generator
# script are build/dev-time only, so keep them out of the image (less bloat and
# attack surface on the published scanner image). Excluding them from the build
# context does not affect CI, which runs pytest on the host checkout.
backend/tests/
backend/scripts/

# Node / frontend (deps + build reinstalled inside the image)
**/node_modules/
frontend/dist/
.vite/
*.tsbuildinfo

# VCS / CI / docs not needed at build time
.git/
.github/
docs/

# IDE / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Logs
logs/
*.log
